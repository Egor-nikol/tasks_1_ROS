<?xml version="1.0"?>
<package format="3">
  <name>shad_interfaces</name>
  <version>0.1.0</version>
  <description>Original ROS 2 interfaces for the SHAD systems engineering lab.</description>
  <maintainer email="course@example.invalid">Course team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
